# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# SUPABASE_URL and SUPABASE_ANON_KEY are safe for client use (protected by RLS).
# SUPABASE_SERVICE_ROLE_KEY MUST ONLY remain on the server (server.ts) and never exposed to client.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Primary Super Admin email (always retains full access)
SUPER_ADMIN_EMAIL="muhtyas.yugioh@gmail.com"

